# =============================================================================
# B2B Invoice Extractor - Environment Configuration Example
# =============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Do not commit real .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application / Docker Compose Network Binding
# -----------------------------------------------------------------------------
# Host IP address to bind frontend port (default: 127.0.0.1 for loopback security)
APP_BIND_ADDRESS=127.0.0.1

# Host port mapped to frontend container (default: 3000)
APP_PORT=3000

# -----------------------------------------------------------------------------
# Backend Storage & Paths (relative to backend/ when running locally)
# -----------------------------------------------------------------------------
# Path to the B2B Excel template (must contain Orders, Boxes, Invoice sheets)
TEMPLATE_PATH=../templates/B2B_bulk_upload_template.xlsx

# Directory where uploaded invoice PDFs are stored during processing
UPLOAD_DIR=./uploads

# Directory where generated Excel workbooks are stored
OUTPUT_DIR=./output

# Directory for persistent JSON state (saved batches and defaults)
STATE_DIR=./data

# Maximum allowed file size per uploaded PDF in megabytes (default: 50)
MAX_FILE_SIZE_MB=50

# Allowed CORS origins for FastAPI (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
